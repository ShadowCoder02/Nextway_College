# Next.js public site URL (used for SEO, sitemap, Open Graph, canonical tags).
# This default is for local dev only — do not change it here. The production
# value is required in Vercel's Production environment scope (the build fails
# loudly without it there); see docs/deployment.md for the current value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — create a project at https://supabase.com (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Management portal login (works without Supabase)
ADMIN_EMAIL=nextwaycollege@gmail.com
ADMIN_PASSWORD=Nextway@2026

# SMTP configuration for applicant verification and confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="Nextway College International <your-email@gmail.com>"

# Alternate names used by the app are also supported
NEXT_SMTP_HOST=smtp.gmail.com
NEXT_SMTP_PORT=587
NEXT_SMTP_USER=your-email@gmail.com
NEXT_SMTP_PASS=your-16-character-app-password

# Do NOT put the service role key in the frontend.

# Vercel Blob — required for applicant document uploads (NIC/passport scans,
# certificates). Create a Blob store under Vercel → Storage → Blob and it
# auto-injects BLOB_READ_WRITE_TOKEN into every environment; `vercel env pull`
# to get it locally. Without it, document upload will fail in every
# environment, local dev included — there's no local-filesystem fallback.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (optional) — shown on register/login after 3 failed
# attempts from the same IP. Leave both unset to disable entirely; get a
# site key + secret key from https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional) — error monitoring is scaffolded (src/instrumentation*.ts,
# src/sentry.*.config.ts) but inert without a DSN, since no Sentry project
# exists for this app yet. Create one at https://sentry.io, then set both
# (NEXT_PUBLIC_ for the browser SDK, plain for server/edge). See
# docs/deployment.md for the remaining step (source map upload) this doesn't
# cover without a real org/project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
